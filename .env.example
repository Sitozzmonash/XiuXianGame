# ---- 凡尘问道 · Vercel 部署环境变量模板 ----
# 真实值见私发文件；在 Vercel 项目 Settings → Environment Variables 中逐项填入。
# Services 模式下两个服务（web / api）共享项目级环境变量。

# Neon PostgreSQL 连接串（api 服务用；应用内自动转换为 postgresql+psycopg:// 方言）
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require

# JWT 签名密钥：随机长字符串（openssl rand -hex 32）；更换会使全部旧 token 失效
JWT_SECRET=<random-64-hex>

# 凭证指纹 HMAC 密钥：随机长字符串，独立于 JWT_SECRET；轮换后旧绑定无法检索
CREDENTIAL_PEPPER=<random-64-hex>

# Vercel Services 按 /api/* 转发且保留原始路径，api 服务必须此前缀；本机开发留空
API_PREFIX=/api

# ---- 可选 ----
# TOKEN_TTL_HOURS=720           # token 有效期（小时）
# MAX_SAVE_BYTES=1048576        # 单份存档上限（字节）
# SNAPSHOT_KEEP=10              # 每账号保留快照份数
# CORS_ORIGINS=*                # 同源部署无需收紧；分离部署时填前端域名

# ---- 测试账号（启动时幂等播种，已存在则不覆盖） ----
# SEED_ADMIN_ENABLED=true       # 置 false 可完全不创建测试账号
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=admin

# ---- 前端（web 服务）可选 ----
# 默认同源调用 /api，无需设置；仅当前后端拆成两个 Vercel 项目时才填后端完整域名
# NEXT_PUBLIC_API_URL=https://<api-project>.vercel.app
