# ---- 常用配置（复制为 .env 即可） ----
# 数据库连接串；本机零依赖跑测试可用默认 SQLite，生产用 PostgreSQL（psycopg3）
# Neon 控制台给的 postgresql:// 串可直接填，应用会自动转 postgresql+psycopg:// 方言
DATABASE_URL=sqlite:///./fanchen.db
# DATABASE_URL=postgresql+psycopg://fanchen:fanchen@localhost:5432/fanchen

# 路由统一前缀：本机开发留空；Vercel Services 部署必须设为 /api（顶层按 /api/* 转发且保留原始路径）
API_PREFIX=

# JWT 签名密钥：生产环境务必替换为随机长字符串（如 openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me-please-set-32bytes

# 凭证指纹专用密钥（HMAC，防离线枚举邮箱/openid）；留空则回退 JWT_SECRET。
# 生产建议单独设置；轮换会导致旧绑定无法再被检索（需数据迁移）。
# CREDENTIAL_PEPPER=

# 访问 token 有效期（小时）
TOKEN_TTL_HOURS=720

# 单份存档体积上限（字节），超限返回 413；默认 1MB
MAX_SAVE_BYTES=1048576

# 每个账号保留的最近存档快照份数
SNAPSHOT_KEEP=10

# ---- 可选（保持默认即可） ----
# CORS_ORIGINS=*                    # 逗号分隔白名单，生产建议填前端域名
# ANALYTICS_MAX_BATCH=500           # 单次埋点批量上限
# ANALYTICS_MAX_PROPS_BYTES=8192    # 单条埋点 props 体积上限
# AUDIT_TOLERANCE_MULT=3.0          # 资源增幅审计宽容倍数
# AUDIT_GRACE_SECONDS=120           # 增幅审计宽限时长（秒）
# AUDIT_CLOCK_SLACK_SECONDS=600     # 客户端时钟最多可放宽的秒数
# AUDIT_STONE_BASE_PER_SEC=1.0      # 灵石挂机速率基线（每秒）
# AUDIT_STONE_PER_STAGE_PER_SEC=0.5 # 灵石每关速率加成（每秒）
# AUDIT_CULTIVATION_BASE_PER_SEC=5.0
# AUDIT_CULTIVATION_PER_STAGE_PER_SEC=2.0
# AUDIT_JADE_FLAT_CAP=300.0         # 仙玉单次增量固定额度（仙玉不按时间产出）
# AUDIT_JADE_PER_STAGE_CAP=1.0
# AUDIT_MIN_CAP=1000.0              # 增量上限的最小值（防低时长误报）
# TRUST_PENALTY_PER_WARNING=5       # 每条 suspicious 警告扣减的信任分
# ACCEPT_ANY_EMAIL_CODE=true        # 邮箱验证码占位模式；接真实短信/邮件服务后置 false
# EMAIL_CODE_PLACEHOLDER=123456
